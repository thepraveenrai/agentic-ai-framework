# ==============================================================================
# Agentic AI Framework - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# LLM Provider: "openrouter", "openai", or "mock"
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_APP_NAME=Agentic AI Framework
MODEL_NAME=deepseek/deepseek-v4-flash-0731
MODEL_TEMPERATURE=0.0

# Direct OpenAI Configuration (optional fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Framework Execution Settings
HITL_ENABLED=true
MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=90.0

# ==============================================================================
# Enterprise Integration Tools Configuration
# ==============================================================================

# 1. GitLab (Branch, Commit, Push, Merge Request)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-personal-access-token
GITLAB_PROJECT_ID=your-group/your-project

# 2. GitHub (Branch, Commit, Push, Pull Request)
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_API_URL=https://api.github.com
GITHUB_REPOSITORY=your-org/your-repo

# 3. Jira (Update Issue Status, Add Comments)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# 4. Gmail (Send Email, Reply to Email)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# 5. Slack (Send Message, Edit Message, Delete Message)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=C12345678

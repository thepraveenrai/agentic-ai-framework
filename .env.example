# ==============================================================================
# Agentic AI Framework - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# LLM Provider: "openrouter", "openai", or "mock"
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_APP_NAME=Agentic AI Framework
MODEL_NAME=deepseek/deepseek-v4-flash-0731
MODEL_TEMPERATURE=0.0

# Direct OpenAI Configuration (optional fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Framework Execution Settings
HITL_ENABLED=true
MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=90.0

# ==============================================================================
# Enterprise Integration Tools Configuration
# ==============================================================================

# 1. GitLab
GITLAB_URL=https://gitlab.mycompany.com        # Or https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx        # Personal Access Token with api scope
GITLAB_PROJECT_ID=my-group/backend-service     # Optional: auto-detected from git origin

# 2. GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx          # Personal Access Token with repo scope
GITHUB_API_URL=https://api.github.com
GITHUB_REPOSITORY=my-org/my-repo               # Optional: auto-detected from git origin

# 3. Jira
JIRA_URL=https://mycompany.atlassian.net
JIRA_EMAIL=your.name@mycompany.com
JIRA_API_TOKEN=your-jira-api-token             # Generated from id.atlassian.com/manage-profile/security/api-tokens

# 4. Gmail
GMAIL_USER=your.work.email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop         # 16-character App Password from Google Account Security
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# 5. Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token            # Bot token with chat:write, chat:write.public scopes
SLACK_DEFAULT_CHANNEL=C0123456789              # Channel ID (or #general)
